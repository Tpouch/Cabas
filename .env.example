POSTGRES_USER=cabas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cabas
DATABASE_URL=postgresql://cabas:change-me@localhost:5432/cabas
UPLOADS_DIR=./uploads
# Port the app listens on (inside its container; also the local port with docker-compose.local.yml)
APP_PORT=3000
TZ=Europe/Paris
# Authentication (see README): generate with `pnpm hash-password` and `openssl rand -base64 48`
APP_PASSWORD_HASH=
SESSION_SECRET=
# true behind HTTPS (Coolify); false for `pnpm dev` and local plain-HTTP tests
COOKIE_SECURE=false
