POSTGRES_USER=cabas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cabas
DATABASE_URL=postgresql://cabas:change-me@localhost:5432/cabas
UPLOADS_DIR=./uploads
APP_PORT=3000
# Address the app listens on: the host's NetBird IP (100.x.y.z) in production, never 0.0.0.0
APP_BIND=127.0.0.1
TZ=Europe/Paris
# Authentication (see README): generate with `pnpm hash-password` and `openssl rand -base64 48`
APP_PASSWORD_HASH=
SESSION_SECRET=
# true only behind HTTPS (reverse proxy); NetBird over plain HTTP needs false
COOKIE_SECURE=false
