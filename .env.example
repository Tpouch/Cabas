POSTGRES_USER=cabas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cabas
DATABASE_URL=postgresql://cabas:change-me@localhost:5432/cabas
UPLOADS_DIR=./uploads
# Port the app listens on and publishes on the server (Nginx Proxy Manager forwards to it)
APP_PORT=3000
# Address to publish on: 0.0.0.0 on the server (firewall it to the proxy), 127.0.0.1 locally
APP_BIND=127.0.0.1
TZ=Europe/Paris
# Authentication (see README): generate with `pnpm hash-password` and `openssl rand -base64 48`
APP_PASSWORD_HASH=
SESSION_SECRET=
# true behind HTTPS (Coolify); false for `pnpm dev` and local plain-HTTP tests
COOKIE_SECURE=false
