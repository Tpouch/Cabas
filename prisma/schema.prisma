generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SizeUnit {
  G
  ML
  PIECE
}

enum PriceSource {
  PURCHASE
  MANUAL
}

enum PromoKind {
  AMOUNT_OFF_PER_UNIT
  PERCENT_OFF
  NTH_PERCENT_OFF
  BUY_GET_FREE
}

model Store {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  /// Lower-cased, trimmed, single-spaced name: enforces case-insensitive uniqueness.
  nameKey   String             @unique @map("name_key")
  address   String?
  logoPath  String?            @map("logo_path")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  prices    PriceObservation[]
  purchases Purchase[]

  @@map("stores")
}

model Product {
  id             String               @id @default(uuid(7)) @db.Uuid
  name           String
  brand          String?
  photoPath      String?              @map("photo_path")
  sizeValue      Int                  @map("size_value")
  sizeUnit       SizeUnit             @map("size_unit")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  prices         PriceObservation[]
  purchaseItems  PurchaseItem[]
  alternativesAs ProductAlternative[] @relation("AlternativeA")
  alternativesBs ProductAlternative[] @relation("AlternativeB")

  @@index([name])
  @@map("products")
}

model PriceObservation {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  priceCents     Int           @map("price_cents")
  observedAt     DateTime      @map("observed_at") @db.Date
  source         PriceSource
  /// Set when the price comes from a purchase line; deleted with it.
  purchaseItemId String?       @unique @map("purchase_item_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@index([productId, storeId, observedAt])
  @@index([storeId])
  @@map("price_observations")
}

model ProductAlternative {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Always the smaller of the two product IDs, so a pair is stored once.
  productAId String   @map("product_a_id") @db.Uuid
  productBId String   @map("product_b_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  productA   Product  @relation("AlternativeA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product  @relation("AlternativeB", fields: [productBId], references: [id], onDelete: Cascade)

  @@unique([productAId, productBId])
  @@index([productBId])
  @@map("product_alternatives")
}

model Purchase {
  id          String         @id @default(uuid(7)) @db.Uuid
  storeId     String         @map("store_id") @db.Uuid
  purchasedAt DateTime       @map("purchased_at") @db.Date
  totalCents  Int            @map("total_cents")
  receiptPath String?        @map("receipt_path")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@index([purchasedAt])
  @@index([storeId])
  @@map("purchases")
}

model PurchaseItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  purchaseId       String            @map("purchase_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  quantity         Decimal           @db.Decimal(10, 3)
  unitPriceCents   Int               @map("unit_price_cents")
  /// One promotion per line; a CHECK constraint ties the parameters to the kind.
  promoKind        PromoKind?        @map("promo_kind")
  promoAmountCents Int?              @map("promo_amount_cents")
  promoPercent     Int?              @map("promo_percent")
  promoNth         Int?              @map("promo_nth")
  promoBuy         Int?              @map("promo_buy")
  promoFree        Int?              @map("promo_free")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  purchase         Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceObservation PriceObservation?

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}
